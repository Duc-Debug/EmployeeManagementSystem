# ============================================================
# EMPLOYEE MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy file này thành .env hoặc set các biến môi trường tương ứng khi chạy.
# ============================================================

# Cấu hình cổng Server (Mặc định 8080)
SERVER_PORT=8080

# Cấu hình Cơ sở dữ liệu MySQL (Dành cho thành viên chạy MySQL Local)
# Bạn có thể dùng định dạng EMS_DB_... hoặc SPRING_DATASOURCE_...
EMS_DB_URL=jdbc:mysql://localhost:3306/employee_management_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
EMS_DB_USERNAME=root
EMS_DB_PASSWORD=your_db_password_here

# Cấu hình H2 Console (false trong production, có thể bật true khi debug)
SPRING_H2_CONSOLE_ENABLED=false

# Cấu hình Khóa Bí mật JWT (Bắt buộc chuỗi 256-bit / 32+ ký tự)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Khởi tạo tài khoản Quản trị viên (Admin) mặc định khi DB chưa có user
INITIAL_ADMIN_ENABLED=true
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=admin123