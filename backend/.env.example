# ============================================================
# EMPLOYEE MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env or set these environment variables in your runtime environment.
# ============================================================

# Active Spring Profile (e.g. 'dev' for local development with H2 console, or 'prod' for production)
# SPRING_PROFILES_ACTIVE=dev

# Server Configuration
SERVER_PORT=8080

# Database Configuration (For Production MySQL)
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/employeedb?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
# SPRING_DATASOURCE_USERNAME=root
# SPRING_DATASOURCE_PASSWORD=your_secure_password

# H2 Console (Disabled by default in production; enabled only in dev profile)
SPRING_H2_CONSOLE_ENABLED=false

# JWT Security Configuration (REQUIRED IN PRODUCTION)
# Must be at least 256 bits (32+ characters) long. Example: openssl rand -base64 48
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Initial Admin Provisioning Configuration
# Used only on first startup when no administrator exists in the database
INITIAL_ADMIN_ENABLED=true
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=your_super_strong_admin_password_here
